# Netlify response headers (security). The local dev server applies the "/*"
# block too (scripts/dev-server.mjs), so the CSP can be tested locally.
#
# Content-Security-Policy: scripts only from this site + the two CDNs in use
# (no inline scripts: the code has none), styles/fonts from the CDNs and Google
# Fonts, video from Cloudinary, network requests only to this site (the chat),
# no plugins, and the site can't be framed by other sites (clickjacking).
# 'wasm-unsafe-eval' (WebAssembly only, not JS eval) and blob: in connect-src are
# needed by the 3D laptop (model-viewer) for its decoder and textures.
# If you add a new external script/font/video host, add it here.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' https://res.cloudinary.com; connect-src 'self' blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Browser caching (Lighthouse "efficient cache lifetimes").
# Images, icons and the 3D model rarely change: 30 days. If one is replaced,
# give it a new file name (or a ?v= query where it is referenced).
# CSS/JS: 1 day. Every CSS/JS reference carries a ?v= version; bump it when
# the file changes, so visitors get the new file right away.
# HTML keeps Netlify's default (always revalidated), so new versions show up.
/images/*
  Cache-Control: public, max-age=2592000
/laptop.glb
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/assets/*
  Cache-Control: public, max-age=86400
